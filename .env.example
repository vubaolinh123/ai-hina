# Copy to .env.local or another ignored file. Never commit real secrets.
HINA_HOST=127.0.0.1
HINA_LOG_LEVEL=INFO
HINA_PROFILE=development

# Local chat defaults to short VTuber-style replies. Raise this explicitly for
# a session that needs long code or step-by-step output.
HINA_MODEL_MAX_TOKENS=192

# Desktop speech input uses GPU faster-whisper with automatic language detection.
# Moonshine Vietnamese Base remains an explicit CPU diagnostic only; it is not
# selected by the GPU-only desktop launcher.
HINA_STT_PROVIDER=faster-whisper
HINA_STT_MODEL=Systran/faster-whisper-large-v3
HINA_STT_MODEL_REVISION=edaa852ec7e145841d8ffdb056a99866b5f0a478
HINA_STT_MODEL_CACHE=var/cache/models/faster-whisper
HINA_STT_DEVICE=cuda
HINA_STT_COMPUTE_TYPE=float16
HINA_STT_ALLOW_DOWNLOAD=true
HINA_STT_CPU_FALLBACK=false
HINA_STT_CPU_THREADS=8
HINA_STT_BEAM_SIZE=1
HINA_STT_TIMEOUT_SECONDS=90
HINA_STT_LANGUAGE=auto

# OmniVoice is the CUDA-only desktop default. Its pretrained weights are
# CC-BY-NC, so this profile is for local non-commercial owner testing only.
HINA_TTS_PROVIDER=omnivoice
HINA_TTS_MODEL=k2-fsa/OmniVoice
HINA_TTS_MODEL_REVISION=c5fdb5ccb189668d56333f77ba2629f4cd7535f4
HINA_TTS_MODEL_CACHE=var/cache/models/omnivoice
HINA_TTS_DEVICE=cuda
HINA_TTS_PRECISION=float16
HINA_TTS_VOICE=Hina Anime AI v1
HINA_TTS_STYLE=tu_nhien
HINA_TTS_ALLOW_DOWNLOAD=true
HINA_TTS_REFERENCE_AUDIO=assets/voices/hina-anime-elevenlabs-reference.wav
HINA_TTS_REFERENCE_SHA256=f71960d949cdebba997cb4a96bc155ee0095dbb42fe6e609e8cf00b41346441f
HINA_TTS_REFERENCE_TEXT=Thôi nào, đừng tự tạo áp lực cho bản thân quá. [sigh] Công việc code dự án hay gỡ lỗi có những ngày bế tắc là chuyện bình thường mà.
HINA_TTS_CPU_THREADS=8
HINA_TTS_TIMEOUT_SECONDS=180
HINA_TTS_MAX_PENDING=2
HINA_TTS_MAX_TEXT_CHARACTERS=2000
HINA_TTS_MAX_CHUNK_CHARACTERS=110
HINA_TTS_MAX_AUDIO_SECONDS=120
HINA_TTS_INFERENCE_STEPS=32
HINA_TTS_GUIDANCE_SCALE=2.0
HINA_TTS_AUDIO_CHUNK_SECONDS=8
HINA_TTS_AUDIO_CHUNK_THRESHOLD_SECONDS=12
HINA_TTS_OMNIVOICE_MAX_SPEAKING_RATE=1.02
HINA_TTS_CUDA_GROWTH_RECYCLE_MIB=512
HINA_TTS_MAX_WARM_REQUESTS=32
HINA_TTS_MODEL_VRAM_MIB=3072

# M06 consent-gated long-term memory. SQLite is authoritative; Qdrant is local
# derived search data and can be rebuilt. No candidate is auto-promoted.
HINA_MEMORY_DATABASE=var/data/hina-memory.sqlite3
HINA_MEMORY_INDEX=var/data/hina-memory-qdrant
HINA_MEMORY_OWNER_ID=owner.local
HINA_MEMORY_COLLECTION=hina_memory_v1
HINA_MEMORY_VECTOR_SIZE=256
HINA_MEMORY_MAX_CANDIDATE_CHARACTERS=2000
HINA_MEMORY_MAX_RECORDS=10000
HINA_MEMORY_DEFAULT_RETRIEVAL_LIMIT=5
HINA_MEMORY_MAX_RETRIEVAL_LIMIT=20
HINA_MEMORY_CONTEXT_BYTE_BUDGET=8192
